  "goals": [
    {
      "id": "g-caffeine",
      "name": "Total caffeine under 400mg/day",
      "what": {
        "t": "tag",
        "tags": [
          "caffeine"
        ],
        "match": "any"
      },
      "when": {
        "t": "calendar",
        "unit": "day",
        "tz": "America/New_York"
      },
      "aggregate": "sum",
      "compare": "<=",
      "target": 400,
      "unit": "mg"
    },
    {
      "id": "g-exercise",
      "name": "150 minutes of exercise per week",
      "what": {
        "t": "tag",
        "tags": [
          "exercise"
        ],
        "match": "any",
        "transitive": true
      },
      "when": {
        "t": "calendar",
        "unit": "week",
        "tz": "America/New_York"
      },
      "aggregate": "duration",
      "compare": ">=",
      "target": 150
    },
    {
      "id": "g-meds",
      "name": "Did I take my meds today",
      "what": {
        "t": "tag",
        "tags": [
          "meds"
        ],
        "match": "any"
      },
      "when": {
        "t": "calendar",
        "unit": "day",
        "tz": "America/New_York"
      },
      "aggregate": "exists",
      "compare": ">",
      "target": 0
    },
    {
      "id": "g-dry",
      "name": "Did I NOT drink this week",
      "what": {
        "t": "track",
        "ids": [
          "alcohol"
        ]
      },
      "when": {
        "t": "calendar",
        "unit": "week",
        "tz": "America/New_York"
      },
      "aggregate": "exists",
      "compare": "==",
      "target": 0
    },
    {
      "id": "g-gym",
      "name": "Exercise on 3 distinct days a week",
      "what": {
        "t": "tag",
        "tags": [
          "exercise"
        ],
        "match": "any",
        "transitive": true
      },
      "when": {
        "t": "calendar",
        "unit": "week",
        "tz": "America/New_York"
      },
      "aggregate": "distinct-days",
      "compare": ">=",
      "target": 3
    },
    {
      "id": "g-screens",
      "name": "No screens 1h before bedtime",
      "what": {
        "t": "tag",
        "tags": [
          "screens"
        ],
        "match": "any"
      },
      "when": {
        "t": "derived",
        "fromTrack": "bedtime",
        "before": "PT1H"
      },
      "aggregate": "exists",
      "compare": "==",
      "target": 0
    },
    {
      "id": "g-weekday-meds",
      "name": "Meds on weekdays only",
      "what": {
        "t": "tag",
        "tags": [
          "meds"
        ],
        "match": "any"
      },
      "when": {
        "t": "filter",
        "of": {
          "t": "calendar",
          "unit": "day",
          "tz": "America/New_York"
        },
        "pred": "is-weekday",
        "tz": "America/New_York"
      },
      "aggregate": "exists",
      "compare": ">",
      "target": 0
    }
  ]
}
